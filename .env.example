# app
APP_ENV="dev"
SERVER_HOST="0.0.0.0"
SERVER_PORT="4000"

# log
LOG_FILTER="info,erp_api=debug,tower_http=debug,sqlx=warn"

# database
DATABASE_URL="postgresql://admin:secret@localhost:5433/erp-db"


# session
ACCESS_TOKEN_NAME="access_token"
ACCESS_TOKEN_TTL_SECS="900"  # 12h 43200
REFRESH_TOKEN_NAME="refresh_token"
REFRESH_TOKEN_TTL_SECS="2592000"  # 30 day
MAX_REFRESH_TOKEN_TTL_SECS="15552000" # 6 month
SESSION_CACHE_TTL_SECS="3600" # 1h
SESSION_DB_SYNC_SECS="60" # 60s
# jwt — sinh mới: openssl rand -base64 32
JWT_SECRET="RcGk0yP5yVZB5jQVyL+Y4tKoR9qt/9ipAE/e7rrqVEw="

# seeder (erp-seeder admin) — chỉ cần cho lần tạo super admin đầu tiên.
# Production: bắt buộc, đặt qua secret store, xoá sau khi tạo xong. Dev: bỏ trống dùng admin@erp.local / Admin@123
SEED_ADMIN_EMAIL="admin@erp.local"
SEED_ADMIN_PASSWORD="Admin@123"
# SEEDER_LOG="info,sqlx=warn"

# cache
REDIS_URL="redis://127.0.0.1:6379"
