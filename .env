
# log
LOG_FILTER="info,erp_api=debug,tower_http=debug,sqlx=warn"
LOG_DIR="logs"
LOG_MAX_FILE="7"


# app
APP_ENV="dev"
CRATE_NAME="erp_api"
SERVER_PORT="4000"
SERVER_HOST="0.0.0.0"

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

SESSION_TTL_SECS=2592000
COOKIE_SECURE=1
# COOKIE_DOMAIN=
# CORS_ALLOWED_ORIGINS=
SESSION_CACHE_TTL_SECS=3600
SESSION_DB_SYNC_SECS=60

# cookie
SESSION_NAME=""
SESSION_EXPIRES=""
COOKIE_SECURE=false

# database
DATABASE_URL="postgresql://admin:secret@localhost:5433/erp-db"

# cache
REDIS_URL=""