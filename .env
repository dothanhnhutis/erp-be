# app
APP_ENV="dev"
CRATE_NAME="erp_api"
SERVER_PORT="4000"
SERVER_HOST="0.0.0.0"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:5173,tauri://localhost,http://tauri.localhost"
# CORS_ALLOWED_METHODS=get,post,put,patch,delete
# CORS_ALLOWED_CREDENTIALS=1
# CORS_ALLOWED_HEADERS

# cookie
COOKIE_SECURE="0"
# COOKIE_DOMAIN=

# session
ACCESS_TOKEN_NAME="access_token"
ACCESS_TOKEN_TTL_SECS="60"  # 12h 43200
REFRESH_TOKEN_NAME="refresh_token"
REFRESH_TOKEN_TTL_SECS="2592000"  # 30 day
MAX_REFRESH_TOKEN_TTL_SECS="15552000" # 6 month
# SESSION_CACHE_TTL_SECS=3600
# SESSION_DB_SYNC_SECS=60

# jwt
JWT_SECRET=""

# cache
REDIS_URL=""

# database
DATABASE_URL="postgresql://admin:secret@localhost:5433/erp-db"



# log
LOG_FILTER="info,erp_api=debug,tower_http=debug,sqlx=warn"
LOG_DIR="logs"
LOG_MAX_FILE="7"